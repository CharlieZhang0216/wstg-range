#!/usr/bin/env python3
"""Vulnerable greeting CGI (WSTG-INJT-08).

Writes the user-supplied `name` verbatim into a .shtml page. Because Apache
runs the INCLUDES output filter over .shtml, any SSI directive in `name`
(e.g. <!--#exec cmd="id" -->) is executed when the page is fetched.
"""
import os
import re
import sys
import urllib.parse
import uuid

PAGES = "/usr/local/apache2/htdocs/pages"


def params():
    q = os.environ.get("QUERY_STRING", "")
    if os.environ.get("REQUEST_METHOD") == "POST":
        n = int(os.environ.get("CONTENT_LENGTH", "0") or 0)
        q = sys.stdin.read(n)
    return urllib.parse.parse_qs(q, keep_blank_values=True)


def main():
    p = params()
    os.makedirs(PAGES, exist_ok=True)

    purge = p.get("purge", [""])[0]
    if purge:
        # lab cleanup helper: only greet-*.shtml files may be removed
        if re.fullmatch(r"greet-[0-9a-f]{10}\.shtml", purge):
            try:
                os.remove(os.path.join(PAGES, purge))
            except OSError:
                pass
        print("Content-Type: text/plain\n\npurged")
        return

    name = p.get("name", [""])[0]
    fn = "greet-" + uuid.uuid4().hex[:10] + ".shtml"
    with open(os.path.join(PAGES, fn), "w") as fh:
        fh.write("<html><head><title>Greeting</title></head><body>\n")
        fh.write("<h1>Hello " + name + "</h1>\n")
        fh.write("<p>Generated by greet.cgi. SSI is enabled on this vhost.</p>\n")
        fh.write("</body></html>\n")

    print("Status: 302 Found")
    print("Location: /pages/" + fn)
    print("Content-Type: text/html")
    print()
    print("<html><body><a href='/pages/%s'>your greeting</a></body></html>" % fn)


main()